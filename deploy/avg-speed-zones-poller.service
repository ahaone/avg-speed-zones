[Unit]
Description=Poll official BGTOLL map/WIM sources once
Documentation=file:/opt/avg-speed-zones/deploy/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
StateDirectory=avg-speed-zones
StateDirectoryMode=0750
WorkingDirectory=/opt/avg-speed-zones
EnvironmentFile=-/etc/avg-speed-zones.env
Environment=AVG_SPEED_REPO_ROOT=/opt/avg-speed-zones
Environment=AVG_SPEED_STATE_DIR=/var/lib/avg-speed-zones
ExecStart=/opt/avg-speed-zones/scripts/avg-speed-poller.sh
SuccessExitStatus=3
Restart=on-failure
RestartSec=15min
TimeoutStartSec=90s
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
